NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sweety:sweety_local@localhost:5432/sweety
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
DB_POOL_SIZE=10
# Authentication attempts per IP in a 15-minute window.
AUTH_RATE_LIMIT=30
# Password work runs off the API thread, with a bounded waiting queue.
HASH_WORKERS=2
HASH_QUEUE_LIMIT=16
# Required only for integration tests: must be a separate disposable database.
TEST_DATABASE_URL=postgresql://sweety:sweety_local@localhost:5432/sweety_test
# Demo only; never use the demo database/account for real patient data.
DEMO_EMAIL=demo@sweety.local
DEMO_PASSWORD=SweetyDemo123!

# Optional extras: omit REDIS_URL to run entirely on PostgreSQL.
REDIS_URL=
REMINDER_HOUR=21

# Optional integration-test Redis; falls back to REDIS_URL.
TEST_REDIS_URL=

# Set maximum process counts including deployment overlap; budget includes worker pools.
API_PROCESSES=1
WORKER_PROCESSES=1
DB_WORKER_POOL_SIZE=2
DB_CONNECTION_BUDGET=80
DB_RESERVED_CONNECTIONS=10
# Required for multiple API processes; use the same URL/prefix on every instance.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_PREFIX=sweety:auth-rate:v1
# Comma-separated trusted reverse-proxy IPs/CIDRs; empty trusts no proxy.
TRUST_PROXY=

# Per-process request admission; extra work gets a bounded wait then HTTP 503.
API_MAX_CONCURRENT=32
API_MAX_QUEUED=64
API_QUEUE_WAIT_MS=1000
# Optional secret (32+ characters) enabling /internal/metrics. Empty disables it.
METRICS_TOKEN=
