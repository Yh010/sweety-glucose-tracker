      "css": ".ds-nav{display:grid;gap:6px;padding:18px;background:var(--green,#164f46)}.ds-nav button{font-family:var(--font-sans,'Manrope Variable','Segoe UI',sans-serif);display:flex;align-items:center;gap:12px;border:0;border-radius:8px;background:transparent;color:#c3d8cb;padding:14px 16px;font-size:13px;font-weight:600;text-align:left;cursor:pointer}.ds-nav button[aria-current]{background:var(--lime,#dcedc7);color:var(--green,#164f46)}.ds-nav button:not([aria-current]):hover{background:#2e6456}.ds-nav button:focus-visible{outline:3px solid #438778;outline-offset:4px}@media(max-width:760px){.ds-nav{display:flex;gap:24px}.ds-nav button{padding:12px 0 15px;border-radius:0}.ds-nav button[aria-current]{background:transparent;color:var(--lime,#dcedc7);border-bottom:2px solid var(--lime,#dcedc7)}}"
