  "narrative": {
    "northStar": "Daylight journal",
    "overview": "Sweety uses an offwhite work surface, forest-green navigation and a pale-green reading form. Quiet borders and open spacing make four daily meal slots and their values easy to scan. This records the implemented system, derived from the React components and stylesheet.\n\nThe interface feels personal and calm. Small Lucide line icons support labels; tabular numbers keep readings aligned. Copy describes a private record without interpreting readings as clinical categories.",
    "keyCharacteristics": [
      "Forest-green rail that becomes top navigation on mobile.",
      "White journal rows beside a pale-green entry form.",
      "Self-hosted Manrope and readable tabular values.",
      "Restrained motion, visible keyboard focus and explicit states."
    ],
    "rules": [
      {
        "name": "The Contextual Contrast Rule",
        "body": "Use the form-specific muted color inside the reading panel rather than inheriting the lighter global muted color.",
        "section": "colors"
      },
      {
        "name": "The Stable Numbers Rule",
        "body": "Keep tabular numerals for glucose values and summaries; retain visible units in the surrounding reading context.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surfaces Rule",
        "body": "Keep journal panels flat; reserve elevation for the existing confirmation layer and selected segment.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the darker form helper color on the pale-green reading panel.",
      "**Do** preserve four named slots, visible units and tabular glucose values.",
      "**Do** reuse the same entry form for Record and Edit, including focus transfer.",
      "**Do** keep chart bounds tied to the report's exact date window.",
      "**Do** preserve keyboard focus, text labels and reduced-motion behavior."
    ],
    "donts": [
      "**Don't** use meal-slot colors as clinical glucose categories.",
      "**Don't** introduce decorative shadows on flat journal panels.",
      "**Don't** remove the shared unit label when hiding per-row units.",
      "**Don't** replace the mobile top navigation with the desktop rail."
    ]
  }
}
