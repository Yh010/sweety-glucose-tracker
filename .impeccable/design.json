      "css": ".ds-field{font-family:var(--font-sans,'Manrope Variable','Segoe UI',sans-serif);display:flex;flex-direction:column;gap:9px;color:var(--ink,#213c34);font-size:12px;font-weight:650}.ds-input-wrap{position:relative}.ds-field input{font-family:var(--font-sans,'Manrope Variable','Segoe UI',sans-serif);width:100%;min-height:46px;border:1px solid #c4d1c7;border-radius:7px;background:white;color:var(--ink,#213c34);padding:11px 58px 11px 12px;font-size:16px;font-weight:500;box-sizing:border-box;caret-color:var(--green,#164f46)}.ds-field input:focus{border-color:var(--green,#164f46)}.ds-field input:focus-visible{outline:3px solid #438778;outline-offset:4px}.ds-field input[aria-invalid=true]{border-color:var(--danger,#a12d29)}.ds-input-wrap>span{position:absolute;right:13px;top:15px;color:#53644f;font-weight:500}.ds-hint{font-family:var(--font-sans,'Manrope Variable','Segoe UI',sans-serif);font-size:12px;line-height:1.7;color:#53644f}"
